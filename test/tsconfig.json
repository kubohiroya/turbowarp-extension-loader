{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // Tests reach for Array.prototype.findLastIndex; the published core stays on the ES2022 surface.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // Internal modules outside "exports" are unit-tested from source, so dist need not exist to typecheck.
    "allowImportingTsExtensions": true,
    // Tests deliberately pass values the public types forbid, and keep unused helpers close to their cases.
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["."],
  // The scratch-vm adapter tests build untyped VM stand-ins; they are checked by their own config.
  "exclude": ["scratch-vm"]
}
