{
  "name": "@kubohiroya/turbowarp-extension-loader",
  "version": "0.17.0",
  "description": "Host-independent verified TurboWarp Plus extension loading core",
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "loader",
    "sb3",
    "manifest",
    "sha-256"
  ],
  "license": "MPL-2.0",
  "author": {
    "name": "Hiroya Kubo",
    "email": "hiroya@cuc.ac.jp",
    "url": "https://github.com/kubohiroya"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-extension-loader.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-plus-editor/issues/4"
  },
  "homepage": "https://github.com/kubohiroya/turbowarp-extension-loader#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./project-codec": {
      "types": "./dist/project-codec.d.ts",
      "default": "./dist/project-codec.js"
    },
    "./project-authoring": {
      "types": "./dist/project-authoring.d.ts",
      "default": "./dist/project-authoring.js"
    },
    "./project-catalog": {
      "types": "./dist/project-catalog.d.ts",
      "default": "./dist/project-catalog.js"
    },
    "./session-trust": {
      "types": "./dist/session-trust.d.ts",
      "default": "./dist/session-trust.js"
    },
    "./webpack4": "./webpack4.cjs",
    "./packager": {
      "types": "./dist/packager.d.ts",
      "default": "./dist/packager.js"
    },
    "./shared-project-archive": {
      "types": "./dist/shared-project-archive.d.ts",
      "default": "./dist/shared-project-archive.js"
    },
    "./scratch-vm": {
      "types": "./dist/scratch-vm/index.d.ts",
      "default": "./dist/scratch-vm/index.js"
    },
    "./scratch-vm/runtime": {
      "types": "./dist/scratch-vm/runtime.d.ts",
      "default": "./dist/scratch-vm/runtime.js"
    },
    "./memory-cache": {
      "types": "./dist/memory-cache.d.ts",
      "default": "./dist/memory-cache.js"
    },
    "./indexeddb-cache": {
      "types": "./dist/indexeddb-cache.d.ts",
      "default": "./dist/indexeddb-cache.js"
    },
    "./scratch-vm/catalog-settings": {
      "types": "./dist/scratch-vm/catalog-settings.d.ts",
      "default": "./dist/scratch-vm/catalog-settings.js"
    },
    "./scratch-vm/catalog-load": {
      "types": "./dist/scratch-vm/catalog-load.d.ts",
      "default": "./dist/scratch-vm/catalog-load.js"
    },
    "./scratch-vm/extension-host": {
      "types": "./dist/scratch-vm/extension-host.d.ts",
      "default": "./dist/scratch-vm/extension-host.js"
    },
    "./scratch-vm/project-size-gate": {
      "types": "./dist/scratch-vm/project-size-gate.d.ts",
      "default": "./dist/scratch-vm/project-size-gate.js"
    },
    "./packager-page": {
      "types": "./dist/packager-page.d.ts",
      "default": "./dist/packager-page.js"
    },
    "./packager-handoff": {
      "types": "./dist/packager-handoff.d.ts",
      "default": "./dist/packager-handoff.js"
    },
    "./catalog-trust": {
      "types": "./dist/catalog-trust.d.ts",
      "default": "./dist/catalog-trust.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.ja.md",
    "README.md",
    "dist",
    "docs",
    "indexeddb-cache.js",
    "memory-cache.js",
    "packager.js",
    "project-authoring.js",
    "project-catalog.js",
    "project-codec.js",
    "scratch-vm.js",
    "scratch-vm/runtime.js",
    "session-trust.js",
    "shared-project-archive.js",
    "webpack4.cjs",
    "EDITOR-MIGRATION.md",
    "src",
    "tsconfig.json",
    "tsconfig.build.json",
    "scratch-vm/catalog-settings.js",
    "scratch-vm/catalog-load.js",
    "scratch-vm/extension-host.js",
    "scratch-vm/project-size-gate.js",
    "packager-page.js",
    "packager-handoff.js",
    "catalog-trust.js"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\" && tsc -p tsconfig.build.json",
    "test": "npm run build && npm run typecheck:scratch-vm && node --test test/*.test.ts test/scratch-vm/*.test.ts",
    "test:browser": "node --test test/browser/*.browser.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "npm run typecheck && npm test && npm run pack:check",
    "prepare": "npm run build",
    "typecheck:scratch-vm": "tsc --noEmit -p test/scratch-vm"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@babel/preset-env": "7.29.14",
    "@kubohiroya/turbowarp-plus-editor-test-runtime": "0.3.2",
    "@turbowarp/jszip": "3.12.0",
    "@turbowarp/packager": "3.14.0",
    "@turbowarp/scratch-storage": "2.2.0",
    "@types/node": "26.6.11",
    "fake-indexeddb": "6.2.8",
    "playwright": "1.65.1",
    "scratch-vm": "github:kubohiroya/scratch-vm#e623546e0e173d70e0314d06d8a17bf84c72afeb",
    "typescript": "6.0.3",
    "@kubohiroya/turbowarp-extension-security-dialog": "0.14.3",
    "jsdom": "26.1.0",
    "@types/jsdom": "21.1.7"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
