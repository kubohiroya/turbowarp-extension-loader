{
  "name": "@kubohiroya/turbowarp-extension-loader",
  "version": "0.2.1",
  "description": "Host-independent verified TurboWarp Plus extension loading core",
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "loader",
    "sb3",
    "manifest",
    "sha-256"
  ],
  "license": "MPL-2.0",
  "author": {
    "name": "Hiroya Kubo",
    "email": "hiroya@cuc.ac.jp",
    "url": "https://github.com/kubohiroya"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-extension-loader.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-plus-editor/issues/4"
  },
  "homepage": "https://github.com/kubohiroya/turbowarp-extension-loader#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./project-codec": {
      "types": "./dist/project-codec.d.ts",
      "default": "./dist/project-codec.js"
    },
    "./project-authoring": {
      "types": "./dist/project-authoring.d.ts",
      "default": "./dist/project-authoring.js"
    },
    "./project-catalog": {
      "types": "./dist/project-catalog.d.ts",
      "default": "./dist/project-catalog.js"
    },
    "./session-trust": {
      "types": "./dist/session-trust.d.ts",
      "default": "./dist/session-trust.js"
    },
    "./webpack4": "./webpack4.cjs",
    "./packager": {
      "types": "./dist/packager.d.ts",
      "default": "./dist/packager.js"
    },
    "./memory-cache": {
      "types": "./dist/memory-cache.d.ts",
      "default": "./dist/memory-cache.js"
    },
    "./indexeddb-cache": {
      "types": "./dist/indexeddb-cache.d.ts",
      "default": "./dist/indexeddb-cache.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.ja.md",
    "README.md",
    "dist",
    "docs",
    "indexeddb-cache.js",
    "memory-cache.js",
    "packager.js",
    "project-authoring.js",
    "project-catalog.js",
    "project-codec.js",
    "session-trust.js",
    "webpack4.cjs"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\" && tsc -p tsconfig.build.json",
    "test": "npm run build && node --test test/*.test.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "npm run typecheck && npm test && npm run pack:check",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@turbowarp/jszip": "3.12.0",
    "@types/node": "26.6.6",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
