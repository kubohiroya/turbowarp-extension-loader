{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@kubohiroya/turbowarp-extension-loader": [
        "./src/index.ts"
      ],
      "@kubohiroya/turbowarp-extension-loader/project-codec": [
        "./src/project-codec.ts"
      ],
      "@kubohiroya/turbowarp-extension-loader/project-authoring": [
        "./src/project-authoring.ts"
      ],
      "@kubohiroya/turbowarp-extension-loader/project-catalog": [
        "./src/project-catalog.ts"
      ],
      "@kubohiroya/turbowarp-extension-loader/session-trust": [
        "./src/session-trust.ts"
      ],
      "@kubohiroya/turbowarp-extension-loader/packager": [
        "./src/packager.ts"
      ],
      "@kubohiroya/turbowarp-extension-loader/scratch-vm": [
        "./src/scratch-vm/index.ts"
      ],
      "@kubohiroya/turbowarp-extension-loader/memory-cache": [
        "./src/memory-cache.ts"
      ],
      "@kubohiroya/turbowarp-extension-loader/indexeddb-cache": [
        "./src/indexeddb-cache.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
